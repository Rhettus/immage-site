---
import Base from "../layouts/Base.astro";
import Compare from "../components/Compare.astro";
import Downloads from "../components/Downloads.astro";
import { features } from "../lib/features";
import { ISSUES, guideHref, guideOr, meta, readmeHref, url } from "../lib/site";

const darktable = await guideOr("darktable", readmeHref());

const rows = features.filter((f) => f.media || f.compare);
const cards = features.filter((f) => !f.media && !f.compare);
const href = (guide: string) => {
  const [id, hash] = guide.split("#");
  return guideHref(id) + (hash ? `#${hash}` : "");
};

const steps = [
  { n: "01", title: "Import", text: "Copy off the card, verified byte for byte, with photos you already have marked.", guide: "import" },
  { n: "02", title: "Cull", text: "Rate, flag, label and keyword in the filmstrip or grid. All of it goes in the sidecar.", guide: "library" },
  { n: "03", title: "Edit", text: "Familiar panels and masks, rendered by darktable.", guide: "adjustments" },
  { n: "04", title: "Share", text: "Export to a folder or an Immich album, framed and captioned.", guide: "export" },
];
---

<Base>
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap intro">
      <a class="pill" href={url("release-notes/")}>
        <span class="dot"></span> Alpha · {meta.release.version} is out
      </a>
      <h1 class="display">Familiar raw editing,<br /><em>darktable</em> underneath.</h1>
      <p class="lede">
        Immage is a raw photo editor with the panels, sliders and shortcuts you already know. Your photos stay in
        folders, your edits stay beside them, and darktable does the processing.
      </p>
      <div class="ctas">
        <a class="btn primary" href={url("#download")}>Download for free</a>
        <a class="btn" href={url("guide/getting-started/")}>Read the guide</a>
      </div>
      <p class="platforms">macOS · Windows · Linux, x86-64 and ARM64</p>
    </div>
    <div class="wrap shot">
      <div class="window frame">
        <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>
        <img
          src={url("media/workspace-2400.webp")}
          srcset={`${url("media/workspace-1200.webp")} 1200w, ${url("media/workspace-2400.webp")} 2400w`}
          sizes="(max-width: 1240px) 100vw, 1200px"
          width="2400"
          height="1298"
          alt="Immage editing a raw photo of a red vintage car: library on the left, the photo in the middle, Adjustments on the right"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <section class="pillars wrap" aria-label="Why Immage">
    <article>
      <h2>darktable does the pixels</h2>
      <p>
        Every edit is a darktable module. Immage adds no processing of its own, so darktable opens an Immage edit and
        renders it the same.
      </p>
      <a href={darktable}>darktable compatibility →</a>
    </article>
    <article>
      <h2>Folders, not a catalog</h2>
      <p>
        Open folders directly. Edits, ratings and keywords are saved automatically in an XMP sidecar beside each photo.
        Originals are never changed.
      </p>
      <a href={guideHref("library")}>The library →</a>
    </article>
    <article>
      <h2>Works with Immich</h2>
      <p>
        Optional: imports skip photos your Immich library already has, the Library panel searches it, and exports go
        straight into an album.
      </p>
      <a href={guideHref("immich")}>Connecting Immich →</a>
    </article>
  </section>

  <section id="features" class="features wrap">
    <p class="eyebrow">What you can do</p>
    <h2 class="display section-title">Everything for the edit. <em>Nothing to relearn.</em></h2>

    {
      rows.map((f, i) => (
        <article class={`row ${i % 2 ? "flip" : ""}`} id={f.id}>
          <div class="copy">
            <h3>{f.title}</h3>
            <p>{f.lede}</p>
            {f.points.length > 0 && (
              <ul>
                {f.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            <a href={href(f.guide)}>Read more in the guide →</a>
          </div>
          <div class="media">
            {f.compare ? (
              <Compare {...f.compare} />
            ) : (
              f.media && (
                <div class={`frame still ${f.media.fit === "top" ? "top" : ""}`}>
                  <img src={url(f.media.src)} alt={f.media.alt} width={f.media.width} height={f.media.height} loading="lazy" />
                </div>
              )
            )}
          </div>
        </article>
      ))
    }

    <div class="grid">
      {
        cards.map((f) => (
          <a class="card" href={href(f.guide)} id={f.id}>
            <h3>{f.title}</h3>
            <p>{f.lede}</p>
            {f.points.length > 0 && <p class="points">{f.points.join(" ")}</p>}
            <span class="more" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="flow wrap" aria-labelledby="flow-title">
    <p class="eyebrow">From card to album</p>
    <h2 id="flow-title" class="display section-title">One app for the <em>whole trip home</em>.</h2>
    <ol>
      {
        steps.map((s) => (
          <li>
            <a href={guideHref(s.guide)}>
              <span class="n">{s.n}</span>
              <strong>{s.title}</strong>
              <span>{s.text}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="callout wrap">
    <div>
      <h2>Using darktable already?</h2>
      <p>
        Try Immage on copies first. It uses a development version of darktable, and stable releases may not read its
        newer module or mask formats. Need every module and full pipeline control? Keep editing in a compatible
        darktable.
      </p>
    </div>
    <a class="btn" href={darktable}>darktable compatibility</a>
  </section>

  <section class="callout wrap alpha">
    <div>
      <h2>Alpha, and honest about it</h2>
      <p>
        Immage is a personal, non-commercial project. Every build is alpha: bugs are expected. If something breaks,
        tell us what you did and what you expected.
      </p>
    </div>
    <a class="btn" href={ISSUES}>Report a problem</a>
  </section>

  <Downloads />
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(56px, 9vw, 110px);
    isolation: isolate;
  }
  .glow {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 46%;
    width: min(1100px, 120vw);
    height: 520px;
    translate: -50% 0;
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--hot-1) 34%, transparent), transparent),
      radial-gradient(closest-side at 70% 60%, color-mix(in srgb, var(--hot-2) 30%, transparent), transparent);
    filter: blur(60px);
    opacity: 0.55;
  }
  .intro {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--bg-raised) 70%, transparent);
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
  }
  .pill:hover {
    color: var(--text);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 10px var(--hot-1);
  }
  h1 {
    font-size: clamp(42px, 7.4vw, 92px);
    margin: 28px 0 22px;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .lede {
    max-width: 640px;
    margin: 0;
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 34px;
  }
  .platforms {
    margin: 18px 0 0;
    color: var(--text-faint);
    font-size: 14px;
  }
  .shot {
    margin-top: clamp(48px, 7vw, 80px);
  }
  .window {
    position: relative;
    background: #111;
    animation: rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both 0.15s;
  }
  .chrome {
    display: flex;
    gap: 7px;
    padding: 11px 14px;
    background: #1b1b20;
    border-bottom: 1px solid #262629;
  }
  .chrome i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3a3a40;
  }
  .window img {
    display: block;
    width: 100%;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(40px) scale(0.98);
    }
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 48px);
    margin-top: 110px;
  }
  .pillars article {
    border-top: 1px solid var(--line-strong);
    padding-top: 22px;
  }
  .pillars h2 {
    font-size: 22px;
    margin: 0 0 10px;
  }
  .pillars p {
    color: var(--text-muted);
    margin: 0 0 14px;
  }
  .pillars a,
  .copy > a {
    text-decoration: none;
    font-weight: 500;
  }

  .features {
    margin-top: 140px;
  }
  .section-title {
    font-size: clamp(34px, 5vw, 58px);
    margin: 14px 0 64px;
    max-width: 16ch;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: center;
    margin-bottom: 96px;
  }
  .row.flip .copy {
    order: 2;
  }
  .copy h3 {
    font-size: clamp(26px, 3vw, 34px);
    margin: 0 0 14px;
  }
  .copy p {
    color: var(--text-muted);
    font-size: 18px;
  }
  .copy ul {
    padding: 0;
    margin: 0 0 22px;
    list-style: none;
  }
  .copy li {
    position: relative;
    padding-left: 22px;
    margin: 8px 0;
  }
  .copy li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--hot);
  }
  .still img {
    display: block;
    width: 100%;
  }
  .still.top {
    max-height: 560px;
    max-width: 380px;
    margin-inline: auto;
    -webkit-mask-image: linear-gradient(#000 75%, transparent);
    mask-image: linear-gradient(#000 75%, transparent);
    border-bottom: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .card {
    position: relative;
    display: block;
    padding: 26px 26px 50px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }
  .card h3 {
    margin: 0 0 10px;
    font-size: 20px;
  }
  .card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 15.5px;
  }
  .card .points {
    margin-top: 8px;
    color: var(--text-faint);
  }
  .more {
    position: absolute;
    left: 26px;
    bottom: 18px;
    color: var(--link);
    transition: translate 0.2s ease;
  }
  .card:hover .more {
    translate: 4px 0;
  }

  .flow {
    margin-top: 140px;
  }
  .flow ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .flow li + li {
    border-left: 1px solid var(--line);
  }
  .flow a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 28px 24px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 15.5px;
    transition: background 0.2s ease;
  }
  .flow a:hover {
    background: var(--bg-raised);
  }
  .flow .n {
    font: 500 13px/1 var(--mono);
    color: var(--hot-1);
  }
  .flow strong {
    color: var(--text);
    font-size: 21px;
    font-weight: 600;
  }

  .callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    margin-top: 100px;
    padding-block: 36px;
    border-block: 1px solid var(--line);
  }
  .callout + .callout {
    margin-top: 0;
    border-top: 0;
  }
  .callout h2 {
    margin: 0 0 8px;
    font-size: 24px;
  }
  .callout p {
    margin: 0;
    color: var(--text-muted);
    max-width: 68ch;
  }
  .callout .btn {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .pillars,
    .row {
      grid-template-columns: 1fr;
    }
    .row.flip .copy {
      order: 0;
    }
    .flow ol {
      grid-template-columns: 1fr 1fr;
    }
    .flow li:nth-child(3) {
      border-left: 0;
    }
    .flow li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .callout {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 520px) {
    .flow ol {
      grid-template-columns: 1fr;
    }
    .flow li + li {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
