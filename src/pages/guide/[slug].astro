---
import { getCollection, render } from "astro:content";
import Guide from "../../layouts/Guide.astro";
import { sourceHref, titleOf } from "../../lib/site";

export async function getStaticPaths() {
  const entries = await getCollection("guide");
  return entries.filter((e) => e.id !== "readme").map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const firstPara = entry.body
  ?.split(/\n\s*\n/)
  .find((p) => p.trim() && !/^[#!<|*-]/.test(p.trim()))
  ?.replace(/\s+/g, " ")
  .replace(/[*_`]|\[([^\]]*)\]\([^)]*\)/g, "$1")
  .slice(0, 200);
---

<Guide title={titleOf(entry)} description={firstPara} id={entry.id} headings={headings} source={sourceHref(entry.id)}>
  <Content />
</Guide>
