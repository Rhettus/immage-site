---
import { getEntry, render } from "astro:content";
import Guide from "../../layouts/Guide.astro";
import { sourceHref } from "../../lib/site";

const entry = (await getEntry("guide", "readme"))!;
const { Content, headings } = await render(entry);
---

<Guide
  title="User guide"
  description="The Immage user guide: getting started, editing tools and settings."
  id="readme"
  headings={headings}
  source={sourceHref("readme")}
>
  <Content />
</Guide>
