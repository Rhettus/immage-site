---
import "../styles/global.css";
import { GITHUB, ISSUES, RELEASES, guideOr, meta, readmeHref, url } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = "darktable, opinionated. Immage is a raw photo editor with familiar panels, sliders and shortcuts, powered by darktable. For macOS, Windows and Linux.",
} = Astro.props;
const pageTitle = title ? `${title} · Immage` : "Immage: darktable, opinionated";
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const darktable = await guideOr("darktable", readmeHref());
const credits = await guideOr("credits", readmeHref("#credits"));
const current = (p: string) => (path.startsWith(url(p)) ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("icon-256.png")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url("media/og.jpg"), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0f0f12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url()} aria-label="Immage home">
          <img src={url("favicon.svg")} alt="" width="30" height="30" />
          <span>Immage</span>
        </a>
        <nav aria-label="Main">
          <a href={url("#features")} class="hide-sm">Features</a>
          <a href={url("guide/")} aria-current={current("guide/")}>Guide</a>
          <a href={url("release-notes/")} aria-current={current("release-notes/")} class="hide-sm">Release notes</a>
          <a href={GITHUB} class="gh" aria-label="Immage on GitHub">
            <svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            <span class="hide-sm">GitHub</span>
          </a>
          <a href={url("#download")} class="btn primary small">Download</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div class="about">
          <a class="brand" href={url()}>
            <img src={url("favicon.svg")} alt="" width="26" height="26" />
            <span>Immage</span>
          </a>
          <p>
            <em class="motto">darktable, opinionated.</em><br />
            A personal, non-commercial raw photo editor built on darktable. Free and open source under the
            GPL-3.0-or-later. All builds are alpha.
          </p>
        </div>
        <nav aria-label="Footer">
          <h2>Get it</h2>
          <a href={url("#download")}>Download</a>
          <a href={RELEASES}>All releases</a>
          <a href={url("release-notes/")}>Release notes</a>
        </nav>
        <nav aria-label="Learn">
          <h2>Learn</h2>
          <a href={url("guide/")}>User guide</a>
          <a href={url("guide/getting-started/")}>Getting started</a>
          <a href={darktable}>darktable compatibility</a>
        </nav>
        <nav aria-label="Project">
          <h2>Project</h2>
          <a href={GITHUB}>Source on GitHub</a>
          <a href={ISSUES}>Report a problem</a>
          <a href={credits}>Credits and licenses</a>
        </nav>
      </div>
      <p class="wrap built">
        Guide built from immage <a href={`${GITHUB}/tree/${meta.sha}`}>{meta.ref}</a> · latest release
        {meta.release.tag}
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .brand img {
    margin: -4px;
  }
  nav[aria-label="Main"] {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.4vw, 28px);
    font-size: 15px;
  }
  nav[aria-label="Main"] > a:not(.btn) {
    color: var(--text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  nav[aria-label="Main"] > a:not(.btn):hover,
  nav[aria-label="Main"] > a[aria-current] {
    color: var(--text);
  }
  .btn.small {
    min-height: 36px;
    padding: 0 16px;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .hide-sm {
      display: none !important;
    }
  }

  .site-footer {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
    padding: 56px 0 32px;
    font-size: 15px;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 32px;
  }
  .about .motto {
    font: italic 400 19px/1.6 var(--display);
    color: var(--text);
  }
  .about p {
    color: var(--text-muted);
    max-width: 34ch;
  }
  .site-footer nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .site-footer h2 {
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 4px 0 6px;
  }
  .site-footer nav a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .site-footer nav a:hover {
    color: var(--text);
  }
  .built {
    margin-top: 40px;
    color: var(--text-faint);
    font-size: 13px;
  }
  .built a {
    color: inherit;
  }
  @media (max-width: 760px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
