---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import "../styles/prose.css";
import { guideHref, guideNav, meta, url } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  id: string; // guide page id, or "" for pages outside the guide
  headings: MarkdownHeading[];
  source: string;
}
const { title, description, id, headings, source } = Astro.props;
const nav = await guideNav();
const flat = nav.flatMap((g) => g.items);
const i = flat.findIndex((p) => p.id === id);
const prev = i > 0 ? flat[i - 1] : undefined;
const next = i >= 0 ? flat[i + 1] : id === "readme" ? flat[0] : undefined;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={title} description={description}>
  <div class="wrap layout">
    <aside class="side">
      <details class="navbox" open>
        <summary>Guide contents</summary>
        <nav aria-label="Guide">
          <a href={url("guide/")} aria-current={id === "readme" ? "page" : undefined}>Overview</a>
          {
            nav.map((g) => (
              <div class="group">
                <p>{g.label}</p>
                {g.items.map((p) => (
                  <a href={guideHref(p.id)} aria-current={p.id === id ? "page" : undefined}>
                    {p.title}
                  </a>
                ))}
              </div>
            ))
          }
          <div class="group">
            <p>Immage</p>
            <a href={url("release-notes/")} aria-current={id === "" ? "page" : undefined}>Release notes</a>
          </div>
        </nav>
      </details>
    </aside>

    <article class="prose">
      <slot />
      <nav class="pager" aria-label="Pages">
        {prev && (
          <a href={guideHref(prev.id)} class="prev">
            <small>Previous</small>{prev.title}
          </a>
        )}
        {next && (
          <a href={guideHref(next.id)} class="next">
            <small>Next</small>{next.title}
          </a>
        )}
      </nav>
      <p class="edit">
        This page is part of immage's own docs, at {meta.ref}. <a href={source}>View the source on GitHub</a>.
      </p>
    </article>

    {
      toc.length > 2 && (
        <aside class="toc" aria-label="On this page">
          <p>On this page</p>
          {toc.map((h) => (
            <a href={`#${h.slug}`} class={`d${h.depth}`}>
              {h.text}
            </a>
          ))}
        </aside>
      )
    }
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 210px;
    gap: 48px;
    max-width: 1360px;
    padding-top: 40px;
  }
  .side,
  .toc {
    position: sticky;
    top: 88px;
    align-self: start;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    font-size: 14.5px;
    scrollbar-width: thin;
  }
  summary {
    display: none;
  }
  .side nav,
  .toc {
    display: flex;
    flex-direction: column;
  }
  .side a,
  .toc a {
    color: var(--text-muted);
    text-decoration: none;
    padding: 5px 10px;
    border-radius: 7px;
    line-height: 1.35;
  }
  .side a:hover,
  .toc a:hover {
    color: var(--text);
  }
  .side a[aria-current] {
    color: var(--text);
    background: var(--bg-raised);
    box-shadow: inset 2px 0 0 var(--hot-1);
  }
  .group {
    display: flex;
    flex-direction: column;
    margin-top: 18px;
  }
  .group p,
  .toc p {
    margin: 0 0 6px 10px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .toc a.d3 {
    padding-left: 22px;
    font-size: 13.5px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
  }
  .pager a {
    flex: 1;
    max-width: 48%;
    padding: 16px 20px;
    border: 1px solid var(--line);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
  }
  .pager a:hover {
    border-color: var(--line-strong);
  }
  .pager .next {
    margin-left: auto;
    text-align: right;
  }
  .pager small {
    display: block;
    color: var(--text-faint);
    font-weight: 400;
    font-size: 13px;
  }
  .edit {
    margin-top: 28px;
    font-size: 14px;
    color: var(--text-faint);
  }
  @media (max-width: 1180px) {
    .layout {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-top: 20px;
    }
    .side {
      position: static;
      max-height: none;
    }
    summary {
      display: block;
      cursor: pointer;
      padding: 12px 14px;
      border: 1px solid var(--line);
      border-radius: 10px;
      font-weight: 500;
    }
    .navbox:not([open]) nav {
      display: none;
    }
    .navbox[open] nav {
      padding: 8px 0 12px;
    }
  }
</style>

<script>
  // On small screens the contents start collapsed.
  if (matchMedia("(max-width: 820px)").matches) document.querySelector(".navbox")?.removeAttribute("open");
</script>
